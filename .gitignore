oracle/**/*.bbl
oracle/**/*.blg
oracle/**/*.log
oracle/**/*.pdf
oracle/**/*.run.xml
oracle/**/*.biber
oracle/**/*.bibsmith
oracle/**/*.ours
!oracle/doc/doc.bcf

# The control file the tests read: it is how biblatex describes the document, not a
# build artefact, and the tests cannot run without it.
!oracle/nyt.bcf
!oracle/style-nyvt.bcf
.hermes/
